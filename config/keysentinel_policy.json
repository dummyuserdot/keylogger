{
  "version": "1.0",
  "detection_rules": {
    "detect_low_level_keyboard_hooks": true,
    "detect_raw_input_sinks": true,
    "detect_polling_getasynckeystate": true,
    "detect_unverified_startup_persistence": true,
    "detect_suspicious_temp_executables": true,
